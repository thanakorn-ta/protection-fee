# คัดลอกเป็น .env.local สำหรับรันในเครื่อง (ห้าม commit ไฟล์ .env.local)
# บน Vercel ตั้งค่าเดียวกันที่ Project → Settings → Environment Variables

# Google Sheet ที่ใช้เป็นฐานข้อมูล (ส่วนที่อยู่ระหว่าง /d/ กับ /edit ใน URL)
SPREADSHEET_ID=

# เนื้อหาไฟล์ JSON key ของ service account ทั้งไฟล์ (หรือ base64 ของไฟล์)
GOOGLE_SERVICE_ACCOUNT_JSON=

# OAuth Client ID ชนิด Web application สำหรับปุ่ม Sign in with Google
GOOGLE_CLIENT_ID=

# สุ่มอย่างน้อย 32 ตัวอักษร ใช้เซ็นคุกกี้ session
SESSION_SECRET=

# อีเมลที่เป็นผู้ดูแลระบบทันทีเมื่อสมัคร (คั่นด้วย ,)
ADMIN_EMAILS=

# จำกัดโดเมนอีเมลที่สมัครได้ เช่น planbmedia.co.th (เว้นว่าง = ทุกบัญชี Google)
ALLOWED_EMAIL_DOMAINS=

# --- ไม่บังคับ ---
# ชื่อแท็บ ถ้าไม่ตั้ง ระบบหาเองจากหัวคอลัมน์
# SHEET_LOCATIONS=
# SHEET_EXAT=
# SHEET_BEM=
# SHEET_USERS=Users
# SHEET_AUDIT=AuditLog

# --- ทดสอบในเครื่องเท่านั้น (npm run dev) ---
# ไม่ตั้ง GOOGLE_SERVICE_ACCOUNT_JSON = ใช้ชีทจำลองใน .mock/sheet.json
# DEV_LOGIN=1 เปิดปุ่มเข้าสู่ระบบทดสอบด้วยอีเมลโดยไม่ใช้ Google
# DEV_LOGIN=1
